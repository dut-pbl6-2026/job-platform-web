VITE_API_BASE_URL=/api
# dev: vite.config.ts proxies /api -> http://localhost:5001 (auth) until gateway YARP exists
# when gateway ready: change vite proxy target to http://localhost:5000
# prod: set VITE_API_BASE_URL to the deployed gateway URL + /api
# Dev proxy target for /ws (gateway). Default http://localhost:5000.
VITE_GATEWAY_URL=http://localhost:5000
# In-app job toast poll interval (ms).
VITE_JOB_TOAST_POLL_MS=30000
# Realtime notifications over /ws/notifications. Keep false until gateway + notif-svc serve it:
# the client sends the access token on the socket URL, which proxies log.
VITE_ENABLE_NOTIFICATION_WS=false

# Offline demo data (localStorage mocks). Leave unset/false on staging and prod:
# a failing API then shows a real error. Even when true, 4xx never falls back.
VITE_ENABLE_MOCKS=false
